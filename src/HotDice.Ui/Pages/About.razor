@page "/about"

<PageTitle>About HotDice</PageTitle>

<MudStack Class="pa-2" Style="max-width: 640px">
  <MudText Typo="Typo.h4" Class="mt-2">About</MudText>

  <MudText Typo="Typo.body1">
    <strong>HotDice</strong> is a real-time, multiplayer take on the classic push-your-luck dice
    game. It doubles as a working sample of <strong>event sourcing</strong>, CQRS and clean
    architecture on .NET — every move is an immutable event, and the read model and live UI are
    projected from that event stream.
  </MudText>

  <MudText Typo="Typo.body2">
    Built with .NET 10, Blazor (Server host + WebAssembly client) and MudBlazor, backed by
    EventStoreDB and PostgreSQL, with real-time turn updates over SignalR. The source is on
    <MudLink Href="https://github.com/david-acm/farkle" Target="_blank">github.com/david-acm/farkle</MudLink>.
  </MudText>

  <MudText Typo="Typo.body2">
    See what's changed in the <MudLink Href="release-notes">release notes</MudLink>, or
    <MudLink Href="https://github.com/david-acm/farkle/issues" Target="_blank">open an issue</MudLink>.
    Thanks for visiting and playing!
  </MudText>

  <MudText Typo="Typo.caption" Class="mt-3" data-testid="app-version">
    Version @AppVersion.Current
  </MudText>
</MudStack>
