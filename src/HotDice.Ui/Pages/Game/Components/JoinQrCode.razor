@using QRCoder

@* Issue #163 — a scannable QR code encoding the deep-link join URL. Generated
   client-side with QRCoder's PngByteQRCode (no System.Drawing, so it runs under
   Blazor WebAssembly) and emitted as a base64 data URI. *@

<img class="join-qr"
     data-testid="join-qr"
     data-join-url="@JoinUrl"
     src="@_dataUri"
     alt="QR code — scan to join this HotDice game" />

@code {
  [Parameter] public string JoinUrl { get; set; } = string.Empty;

  // Game palette: brand-yellow modules on the dark "ink" background, matching
  // the lobby. Contrast stays ~15:1 (the same pairing as the yellow text), and
  // modern phone cameras read this inverted (light-on-dark) orientation fine.
  private static readonly byte[] ModuleRgba = [0xFF, 0xE6, 0x00, 0xFF];     // #FFE600 (the code)
  private static readonly byte[] BackgroundRgba = [0x0A, 0x0A, 0x1A, 0xFF]; // #0A0A1A

  private string _dataUri = string.Empty;

  protected override void OnParametersSet()
  {
    using var generator = new QRCodeGenerator();
    using var data = generator.CreateQrCode(JoinUrl, QRCodeGenerator.ECCLevel.M);
    using var qr = new PngByteQRCode(data);
    var png = qr.GetGraphic(8, ModuleRgba, BackgroundRgba);
    _dataUri = $"data:image/png;base64,{Convert.ToBase64String(png)}";
  }
}
