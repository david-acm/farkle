@inherits HotDice.Ui.Features.GameStateComponent
@using HotDice.SharedKernel.Scoring

@* #275 — the potential score of the current selection, UNDER the dice. The score (prepended
   with "+") is on its own line in the turn-score font; the trick description is on the line
   below it (no parentheses). The row is a STABLE-HEIGHT placeholder (always rendered, reserving
   both lines) so the layout never shifts as the selection changes. "+0" with no description for
   a non-scoring selection; blank when nothing is selected. *@
<div class="selection-score" data-testid="selection-preview">
  @if (HasSelection)
  {
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="selection-score-points">+@Preview.Points</MudText>
    @if (Scores)
    {
      <MudText Typo="Typo.caption" Class="selection-score-tricks">@Label</MudText>
    }
  }
</div>

@code {
  private ScoreBreakdown Preview => GameState.SelectionPreview;

  private bool HasSelection => GameState.DiceSetAside.Count > 0;

  private bool Scores => Preview.CanKeep && Preview.Points > 0;

  // The component tricks, casual and joined with " + " (e.g. "ones + 3 of a kind").
  private string Label => Preview.ToDisplayName();
}
