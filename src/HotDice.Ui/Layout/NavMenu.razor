@inherits HotDice.Ui.Features.GameStateComponent

<MudNavMenu>
  @* #390 — once joined, "Play" leads back to the current game; the landing page would start a new one. *@
  <MudNavLink Href="@PlayHref"
              Match="NavLinkMatch.All"
              Icon="@Icons.Material.Filled.Casino">
    Play
  </MudNavLink>
  <MudNavLink Href="scoring"
              Match="NavLinkMatch.Prefix"
              Icon="@Icons.Material.Filled.Calculate">
    Scoring
  </MudNavLink>
  <MudNavLink Href="about"
              Match="NavLinkMatch.Prefix"
              Icon="@Icons.Material.Filled.Info">
    About
  </MudNavLink>
  <MudNavLink Href="release-notes"
              Match="NavLinkMatch.Prefix"
              Icon="@Icons.Material.Filled.NewReleases">
    Release notes
  </MudNavLink>
</MudNavMenu>

@code {
  private string PlayHref =>
    GameState.HasJoined ? $"games/{GameState.GameId.Value}" : string.Empty;
}
