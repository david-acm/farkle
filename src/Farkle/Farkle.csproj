<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <RootNamespace>Farkle</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.Result" Version="10.1.0" />
    <PackageReference Include="Ardalis.Result.AspNetCore" Version="10.1.0" />
    <PackageReference Include="Ardalis.SmartEnum" Version="8.2.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.EventGrid" Version="5.0.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <!-- Eventuous: pinned to the stable 0.15.1 release. Migration to 0.16.x requires further
         API updates tracked in a separate issue. Only the *abstractions* live here (command
         service, aggregate/state base types, subscription handler base, type map). The concrete
         EventStoreDB transport (Eventuous.EventStore + EventStore.Client.*) lives in
         Farkle.Infrastructure.
         Note: Eventuous.AspNetCore and Eventuous.AspNetCore.Web were dropped — neither has a
         0.15.1 release (max beta.7 / rc.1) and both were unused (the command-mapping they
         provide is replaced by FastEndpoints; MapCommands is not used). -->
    <PackageReference Include="Eventuous.Application" Version="0.15.1" />
    <PackageReference Include="Eventuous.Extensions.DependencyInjection" Version="0.15.1" />
    <PackageReference Include="Eventuous.Persistence" Version="0.15.1" />
    <PackageReference Include="Eventuous.Subscriptions" Version="0.15.1" />
    <PackageReference Include="Eventuous.Shared" Version="0.15.1" />
    <PackageReference Include="FastEndpoints" Version="8.1.0" />
    <PackageReference Include="Mapster" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.Azure.AppConfiguration.AspNetCore" Version="8.5.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Farkle.Contracts\Farkle.Contracts.csproj" />
    <ProjectReference Include="..\Farkle.SharedKernel\Farkle.SharedKernel.csproj" />
  </ItemGroup>

</Project>
