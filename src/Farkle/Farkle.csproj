<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <RootNamespace>Farkle</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.Result" Version="10.1.0" />
    <PackageReference Include="Ardalis.Result.AspNetCore" Version="10.1.0" />
    <PackageReference Include="Ardalis.SmartEnum" Version="8.2.0" />
    <!-- SmartEnum STJ converter — required for GameState (ImmutableArray<DieValue>) to round-trip
         as a Marten document (ADR 0004, spike-verified). -->
    <PackageReference Include="Ardalis.SmartEnum.SystemTextJson" Version="8.1.0" />
    <!-- Critter Stack (#302): Marten 9 event store + Wolverine 6 aggregate handlers over PostgreSQL.
         RuntimeCompilation is the dev codegen path; prod switches to static codegen (#305). -->
    <PackageReference Include="Marten" Version="9.12.0" />
    <PackageReference Include="WolverineFx.Marten" Version="6.16.0" />
    <PackageReference Include="WolverineFx.Http" Version="6.16.0" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.16.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.EventGrid" Version="5.0.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <!-- #292 — FastEndpoints moved to the Farkle.Endpoints project with the HTTP endpoints, so
         the domain/application core no longer compiles against the web framework. -->
    <PackageReference Include="Mapster" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <!-- Transitive pin (via Swashbuckle / Microsoft.AspNetCore.OpenApi): force off 2.4.1, which
         has a high-severity advisory (GHSA-v5pm-xwqc-g5wc, NU1903). Remove once the direct deps
         pull a patched version themselves. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.8.0" />
    <PackageReference Include="Microsoft.Azure.AppConfiguration.AspNetCore" Version="8.5.0" />
    <PackageReference Include="Polly.Core" Version="8.6.6" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <!-- #303 — the vertical slices now own their Wolverine.HTTP endpoints, so the core compiles
       against the ASP.NET shared framework (routing, results, OpenAPI). The shared kernel stays
       web-free (the generalized arch guardrail). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Farkle.Contracts\Farkle.Contracts.csproj" />
    <ProjectReference Include="..\Farkle.SharedKernel\Farkle.SharedKernel.csproj" />
  </ItemGroup>

</Project>
