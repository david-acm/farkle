<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <RootNamespace>Farkle</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.Result" Version="10.1.0" />
    <PackageReference Include="Ardalis.Result.AspNetCore" Version="10.1.0" />
    <PackageReference Include="Ardalis.SmartEnum" Version="8.2.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.EventGrid" Version="5.0.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageReference Include="EventStore.Client.Grpc" Version="23.3.9" />
    <PackageReference Include="EventStore.Client.Grpc.Streams" Version="23.3.9" />
    <!-- Eventuous: pinned to last beta compatible with current application code.
         Migration to stable 0.16.x requires API updates tracked in a separate issue. -->
    <PackageReference Include="Eventuous.Application" Version="0.15.0-beta.10" />
    <PackageReference Include="Eventuous.AspNetCore" Version="0.15.0-beta.7" />
    <PackageReference Include="Eventuous.AspNetCore.Web" Version="0.15.0-beta.10" />
    <PackageReference Include="Eventuous.EventStore" Version="0.15.0-beta.10" />
    <PackageReference Include="Eventuous.Extensions.DependencyInjection" Version="0.15.0-beta.10" />
    <PackageReference Include="Eventuous.Persistence" Version="0.16.4" />
    <PackageReference Include="Eventuous.Shared" Version="0.16.4" />
    <!-- FastEndpoints: pinned to 5.x — migration to 8.x requires API updates tracked separately. -->
    <PackageReference Include="FastEndpoints" Version="5.34.0" />
    <PackageReference Include="Mapster" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.Azure.AppConfiguration.AspNetCore" Version="8.5.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Farkle.Contracts\Farkle.Contracts.csproj" />
    <ProjectReference Include="..\Farkle.SharedKernel\Farkle.SharedKernel.csproj" />
  </ItemGroup>

</Project>
