<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Farkle.Endpoints</RootNamespace>
  </PropertyGroup>

  <!-- #292 — the HTTP delivery layer. Extracted out of the Farkle core so the domain/application
       core no longer compiles against the web framework (FastEndpoints). References the core for
       its commands/services (internal, via [InternalsVisibleTo]) and the DTO contracts. -->
  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Farkle\Farkle.csproj" />
    <ProjectReference Include="..\Farkle.Contracts\Farkle.Contracts.csproj" />
  </ItemGroup>

</Project>
