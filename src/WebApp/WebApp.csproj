<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>93421bc4-e479-40e2-80fe-1138d1aa7207</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Farkle.WebTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="serilog.aspnetcore" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.7" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" Version="4.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="FastEndpoints.Security" Version="8.1.0" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.1.0" />
    <!-- Persistence (EF/Npgsql/Identity), event store and health checks now live in
         Farkle.Infrastructure; the host references them transitively through that project. -->
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../.dockerignore">
      <Link>.dockerignore</Link>
      <DependentUpon>Dockerfile</DependentUpon>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSwag.MSBuild" Version="14.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="GenerateSwaggerJson" AfterTargets="Build" Condition="'$(GenerateSwagger)' == 'true'">
    <Exec Command="$(NSwagExe_Net80) run nswag.json /variables:Configuration=$(Configuration)" EnvironmentVariables="ASPNETCORE_ENVIRONMENT=NSwag" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Farkle\Farkle.csproj" />
    <ProjectReference Include="..\WebApp.Client\WebApp.Client.csproj" />
    <ProjectReference Include="..\Farkle.Infrastructure\Farkle.Infrastructure.csproj" />
  </ItemGroup>

</Project>
