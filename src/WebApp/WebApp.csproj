<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>93421bc4-e479-40e2-80fe-1138d1aa7207</UserSecretsId>
    <!-- Only boot the host to emit the OpenAPI document when explicitly asked (verify-generated);
         a normal build must not run the GetDocument tool. -->
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HotDice.WebTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.5.0" />
    <PackageReference Include="serilog.aspnetcore" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <!-- Transitive pin (via Microsoft.AspNetCore.OpenApi): force off 2.4.1, which has a
         high-severity advisory (GHSA-v5pm-xwqc-g5wc, NU1903). Remove once the direct deps
         pull a patched version themselves. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <!-- #302 follow-up — FluentValidation input-validation middleware for Wolverine.HTTP. Guards the
         request DTOs (out-of-range dice, empty names) so bad input becomes a 400 ValidationProblem
         before the endpoint runs, rather than a 500 from DieValue.FromValue. Business rules stay in
         the deciders (validation-as-events); this only covers structural/input validity. -->
    <PackageReference Include="WolverineFx.Http.FluentValidation" Version="6.16.0" />
    <!-- Persistence (EF/Npgsql/Identity), event store and health checks now live in
         HotDice.Infrastructure; the host references them transitively through that project. -->
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../.dockerignore">
      <Link>.dockerignore</Link>
      <DependentUpon>Dockerfile</DependentUpon>
    </Content>
  </ItemGroup>

  <!-- #303 — build-time OpenAPI generation (replaces the NSwag pipeline). When GenerateSwagger=true
       the GetDocument tool boots the host (in the NSwag environment: DB-free lightweight Marten,
       static-asset + seed guards) and writes the document straight to the shared swagger.json that
       Kiota consumes. verify-generated builds with -p:GenerateSwagger=true and diffs the result. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup Condition="'$(GenerateSwagger)' == 'true'">
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../WebApp.Client</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name swagger</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HotDice\HotDice.csproj" />
    <ProjectReference Include="..\WebApp.Client\WebApp.Client.csproj" />
    <ProjectReference Include="..\HotDice.Infrastructure\HotDice.Infrastructure.csproj" />
  </ItemGroup>

</Project>
