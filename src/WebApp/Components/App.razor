@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    // #33 — browser/UI telemetry. The App Insights connection string is server config (the
    // APPLICATIONINSIGHTS_CONNECTION_STRING env var). It is inherently client-visible for
    // browser telemetry, so rendering it into the page is expected. Absent locally → no script.
    var appInsightsConnectionString = Configuration["APPLICATIONINSIGHTS_CONNECTION_STRING"];
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

  <link href="WebApp.styles.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
	
	
    <link rel="icon" type="image/png" href="favicon.ico" />
    <HeadOutlet @rendermode="@InteractiveWebAssembly" />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
	<script src="_content/MudBlazor/MudBlazor.min.js"></script>
    @if (!string.IsNullOrWhiteSpace(appInsightsConnectionString))
    {
        // Application Insights JavaScript SDK: captures page views, browser AJAX (fetch/XHR) as
        // dependencies, and unhandled JS exceptions.
        <script src="https://js.monitor.azure.com/scripts/b/ai.3.gbl.min.js" crossorigin="anonymous"></script>
        <script>
            (function () {
                var ai = new Microsoft.ApplicationInsights.ApplicationInsights({
                    config: {
                        connectionString: "@appInsightsConnectionString",
                        // #223 — enableAutoRouteTracking is deliberately OFF. It listens to History
                        // API events, but Blazor Web Apps navigate via *enhanced navigation*
                        // (fetch + DOM patch), which the SDK hooks unreliably (symptom: almost no
                        // pageViews recorded). We track SPA navigation explicitly below instead.
                        enableAutoRouteTracking: false,
                        autoTrackPageVisitTime: true
                        // AJAX/dependency correlation is governed by distributedTracingMode
                        // (default AI_AND_W3C), independent of route tracking — so it stays intact.
                    }
                });
                ai.loadAppInsights();
                ai.trackPageView(); // initial (cross-document) load
                // Expose the instance so the UI-intent helper (window.farkleTelemetry, below)
                // can emit custom events. Local to this IIFE otherwise.
                window.appInsights = ai;

                // #223 — track each in-app navigation explicitly. "enhancednavigationend" fires
                // once after every enhanced navigation (unlike "enhancedload", which also fires on
                // streaming updates and would duplicate). It does NOT fire on the initial document
                // load, so it never doubles the trackPageView() above. Manually calling
                // trackPageView resets the operation id, preserving per-page telemetry grouping.
                if (window.Blazor && window.Blazor.addEventListener) {
                    window.Blazor.addEventListener("enhancednavigationend", function () {
                        ai.trackPageView();
                    });
                }
            })();
        </script>
    }
    <script>
        // Issue #225 — UI intent telemetry. Defined unconditionally so JS interop never throws;
        // a no-op when App Insights isn't loaded (no connection string locally). Custom events
        // are namespaced "UI.*" so they're separable from server-side domain events in KQL.
        window.farkleTelemetry = {
            trackEvent: function (name, properties) {
                if (window.appInsights) {
                    window.appInsights.trackEvent({ name: name }, properties);
                }
            },
            // #244 / #250 — start a fresh operation per server-bound command AND record the UI action
            // as a real span (a dependency) so the command's browser fetch — and thus the server
            // request, events and broadcast — nest UNDER it in the transaction tree (not as siblings
            // of a phantom parent). The UI action span is the operation root; setting
            // telemetryTrace.parentID to ITS id makes the auto-tracked fetch a child of it.
            // No-op when App Insights isn't loaded.
            startCommand: function (name) {
                var ai = window.appInsights;
                if (!ai) return;
                var ctx = (ai.context && ai.context.telemetryTrace)
                       || (ai.properties && ai.properties.context && ai.properties.context.telemetryTrace);
                if (!ctx) return;
                function hex(n) { var s = ''; for (var i = 0; i < n; i++) s += (Math.random() * 16 | 0).toString(16); return s; }
                var traceId = hex(32), spanId = hex(16);
                // New operation; the UI-action span sits at its root (no parent).
                ctx.traceID = traceId;
                ctx.parentID = "";
                try {
                    ai.trackDependencyData({
                        id: spanId, name: "UI." + name, type: "InProc",
                        duration: 0, success: true, responseCode: 0
                    });
                } catch (e) { /* best-effort */ }
                // #250 — the SDK stores the dependency's id in its legacy hierarchical form with a
                // TRAILING DOT (e.g. "<spanId>."), but a child's operation_ParentId is whatever we put
                // in telemetryTrace.parentID verbatim. So children must reference "<spanId>." (with the
                // dot) to match the UI-action span's stored id — otherwise the span renders detached at
                // the top of the transaction instead of as the parent of the fetch.
                ctx.parentID = spanId + ".";
            }
        };
    </script>
    <script>
        // Issue #163 — share the join link via the Web Share API, with a
        // clipboard fallback. share() returns false only when the API is
        // unavailable so the caller can fall back to copy().
        window.farkleShare = {
            share: async function (title, text, url) {
                if (!navigator.share) return false;
                try { await navigator.share({ title: title, text: text, url: url }); }
                catch (e) { /* user cancelled or share failed — nothing to do */ }
                return true;
            },
            copy: async function (text) {
                try { await navigator.clipboard.writeText(text); return true; }
                catch (e) { return false; }
            }
        };
    </script>
</body>

</html>
