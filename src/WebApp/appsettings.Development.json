{
  "ConnectionStrings": {
    "Identity": "Host=localhost;Port=5432;Database=farkle_identity;Username=farkle;Password=farkle_dev_password"
  },
  "BackendUrl": "http://localhost:5157",
  "Auth": {
    "RequireAuthorization": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5157",
      "https://localhost:7149"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Debug",
        "System": "Warning",
        "Grpc": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      }
    ]
  }
}
