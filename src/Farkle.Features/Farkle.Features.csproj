<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Farkle.Features</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Critter Stack write/read path (#302). Marten 9 event store + Wolverine 6 aggregate
         handlers over PostgreSQL. RuntimeCompilation is the dev codegen path — Wolverine 6 no
         longer bundles the Roslyn compiler; prod switches to pre-generated static codegen (#305). -->
    <PackageReference Include="Marten" Version="9.12.0" />
    <PackageReference Include="WolverineFx.Marten" Version="6.16.0" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Farkle\Farkle.csproj" />
    <ProjectReference Include="..\Farkle.Contracts\Farkle.Contracts.csproj" />
    <ProjectReference Include="..\Farkle.SharedKernel\Farkle.SharedKernel.csproj" />
  </ItemGroup>

</Project>
