@page "/games/{ParameterGameId:int}"
@inherits BlazorState.BlazorStateComponent
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Play Farkle!</PageTitle>

@if (!HasJoined)
{
  <MudText Typo="Typo.h3">Farkle!</MudText>
  <GameTitle></GameTitle>

  <MudCard Class="mt-4" Style="max-width: 400px">
    <MudCardContent>
      <MudText Typo="Typo.h6" Class="mb-2">Enter your name to join</MudText>
      <MudTextField @bind-Value="_playerName"
                    Label="Your name"
                    Placeholder="Your name"
                    Variant="Variant.Outlined"
                    Immediate="true" />
    </MudCardContent>
    <MudCardActions>
      <MudButton Variant="Variant.Filled"
                 Color="Color.Primary"
                 Disabled="@(string.IsNullOrWhiteSpace(_playerName))"
                 OnClick="JoinAsync">Join Game</MudButton>
    </MudCardActions>
  </MudCard>
}
else if (GameState.IsInLobby)
{
  <MudText Typo="Typo.h3">Farkle!</MudText>
  <GameTitle></GameTitle>
  <Lobby />
}
else
{
  <div class="play-area">
    <header class="play-header">
      <MudText Typo="Typo.h4" Class="play-heading">Farkle!</MudText>
      <div class="play-id"><GameTitle></GameTitle></div>
    </header>

    <MudGrid Spacing="1" Class="play-info">
      <MudItem xs="7" sm="6" md="4">
        <TurnStatus />
      </MudItem>
      <MudItem xs="5" sm="6" md="4">
        <TurnScore></TurnScore>
      </MudItem>
      <MudItem xs="12" sm="12" md="4">
        <Scoreboard />
      </MudItem>
    </MudGrid>

    <div class="play-dice">
      <DragabbleDice>
      </DragabbleDice>
    </div>

    <div class="play-controls">
      <MudGrid Spacing="1">
        <MudItem xs="4">
          <RollDiceButton IsDisabled="@(!GameState.IsMyTurn)" />
        </MudItem>
        <MudItem xs="4">
          <KeepButton IsDisabled="@(!GameState.IsMyTurn)" />
        </MudItem>
        <MudItem xs="4">
          <PassTurnButton IsDisabled="@(!GameState.IsMyTurn)" />
        </MudItem>
      </MudGrid>
    </div>
  </div>
}
