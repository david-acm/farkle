@page "/games/{ParameterGameId:int}"
@inherits BlazorState.BlazorStateComponent
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Play Farkle!</PageTitle>

<MudText Typo="Typo.h3">Farkle!</MudText>
<GameTitle></GameTitle>

@if (!HasJoined)
{
  <MudCard Class="mt-4" Style="max-width: 400px">
    <MudCardContent>
      <MudText Typo="Typo.h6" Class="mb-2">Enter your name to join</MudText>
      <MudTextField @bind-Value="_playerName"
                    Label="Your name"
                    Placeholder="Your name"
                    Variant="Variant.Outlined"
                    Immediate="true" />
    </MudCardContent>
    <MudCardActions>
      <MudButton Variant="Variant.Filled"
                 Color="Color.Primary"
                 Disabled="@(string.IsNullOrWhiteSpace(_playerName))"
                 OnClick="JoinAsync">Join Game</MudButton>
    </MudCardActions>
  </MudCard>
}
else if (GameState.IsInLobby)
{
  <Lobby />
}
else
{
  <MudGrid Spacing="1">
    <MudItem xs="12" sm="6" md="4">
      <MudText Class="mt-6" Typo="Typo.h5">
        Roll the dice and don't Farkle!
      </MudText>
      <MudText Typo="Typo.subtitle1">
        Playing as: <strong>@GameState.PlayerName.Value</strong>
      </MudText>
      @{
        var waitingFor = GameState.Scoreboard
            .FirstOrDefault(p => p.PlayerId == GameState.CurrentPlayerId)?.Name
            ?? $"Player {GameState.CurrentPlayerId}";
      }
      @if (GameState.IsMyTurn)
      {
        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2" data-testid="my-turn-indicator">
          It's your turn!
        </MudAlert>
      }
      else
      {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2" data-testid="waiting-indicator">
          Waiting for @waitingFor…
        </MudAlert>
      }
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
      <TurnScore></TurnScore>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
      <Scoreboard />
    </MudItem>
  </MudGrid>

  <MudContainer Class="mt-8">
    <DragabbleDice>
    </DragabbleDice>
  </MudContainer>

  <MudGrid Spacing="1" Class="mt-4">
    <MudItem xs="12" sm="4">
      <RollDiceButton IsDisabled="@(!GameState.IsMyTurn)" />
    </MudItem>
    <MudItem xs="12" sm="4">
      <KeepButton IsDisabled="@(!GameState.IsMyTurn)" />
    </MudItem>
    <MudItem xs="12" sm="4">
      <PassTurnButton IsDisabled="@(!GameState.IsMyTurn)" />
    </MudItem>
  </MudGrid>
}
