@using QRCoder

@* Issue #163 — a scannable QR code encoding the deep-link join URL. Generated
   client-side with QRCoder's PngByteQRCode (no System.Drawing, so it runs under
   Blazor WebAssembly) and emitted as a base64 data URI. *@

<img class="join-qr"
     data-testid="join-qr"
     data-join-url="@JoinUrl"
     src="@_dataUri"
     alt="QR code — scan to join this Farkle game" />

@code {
  [Parameter] public string JoinUrl { get; set; } = string.Empty;

  // Game palette: dark "ink" modules on a brand-yellow background. Keeping the
  // dark-on-light orientation with ~15:1 contrast (the same pairing as the
  // yellow buttons) means the code stays reliably scannable while on-brand.
  private static readonly byte[] DarkRgba = [0x0A, 0x0A, 0x1A, 0xFF]; // #0A0A1A
  private static readonly byte[] LightRgba = [0xFF, 0xE6, 0x00, 0xFF]; // #FFE600

  private string _dataUri = string.Empty;

  protected override void OnParametersSet()
  {
    using var generator = new QRCodeGenerator();
    using var data = generator.CreateQrCode(JoinUrl, QRCodeGenerator.ECCLevel.M);
    using var qr = new PngByteQRCode(data);
    var png = qr.GetGraphic(8, DarkRgba, LightRgba);
    _dataUri = $"data:image/png;base64,{Convert.ToBase64String(png)}";
  }
}
