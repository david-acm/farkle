@inherits BlazorState.BlazorStateComponent

<div class="dice-area">
  <MudDropContainer Class="drop-zones"
                    ItemDropped="ItemUpdatedAsync"
                    ItemDraggingClass="die-dragging"
                    Items="GameState.DiceInPlay"
                    ItemsSelector="@((item, dropzone) => item.Identifier == dropzone)"
                    T="DraggableDie">
    <ChildContent>

      <MudDropZone Class="zone zone--rolled" Identifier="Rolled" T="DraggableDie">
        <MudText Class="zone-title" Color="Color.Primary" Typo="Typo.subtitle1">In Play</MudText>
      </MudDropZone>

      <MudDropZone Class="zone zone--aside" Identifier="SetAside" T="DraggableDie">
        <MudText Class="zone-title" Color="Color.Primary" Typo="Typo.subtitle1">Set Aside 🎯</MudText>
      </MudDropZone>

    </ChildContent>

    <ItemRenderer>
      <div class="die-slot" @key="context.Index">
        <Die DieValue="context.Value"
             Animate="context.Animate"
             Size="32">
        </Die>
      </div>
    </ItemRenderer>
  </MudDropContainer>
</div>
