@inherits BlazorState.BlazorStateComponent

<MudDropContainer Class="drop-zones"
                  ItemDropped="ItemUpdatedAsync"
                  Items="GameState.DiceInPlay"
                  ItemsSelector="@((item, dropzone) => item.Identifier == dropzone)"
                  T="DraggableDie">
  <ChildContent>

    <MudDropZone Class="d-flex flex-grow-1 flex-row flex-wrap justify-center pa-4 rounded zone"
                 Identifier="Rolled"
                 T="DraggableDie">
      <MudText Class="zone-title" Color="Color.Primary" Typo="Typo.h6">
        In Play
      </MudText>
    </MudDropZone>

    <MudDropZone Class="d-flex flex-grow-1 flex-row flex-wrap justify-center pa-4 rounded zone"
                 Identifier="SetAside"
                 Style="border: 2px dashed #FFE600;"
                 T="DraggableDie">
      <MudText Class="zone-title" Color="Color.Primary" Typo="Typo.h6">
        Set Aside 🎯
      </MudText>
    </MudDropZone>

  </ChildContent>

  <ItemRenderer>
    <MudItem Class="align-center d-flex mx-3 my-8">
      <Die DieValue="context.Value"
           IsDragging="context.IsDragging"
           Size="50">
      </Die>
    </MudItem>
  </ItemRenderer>
</MudDropContainer>