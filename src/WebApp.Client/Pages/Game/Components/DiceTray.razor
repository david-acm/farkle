@inherits BlazorState.BlazorStateComponent
@using WebApp.Client.Features

@* #182 — tap-to-select dice tray (replaces the drag-and-drop two-zone DragabbleDice).
   Every rolled die sits in one grid; tapping toggles its selection in place. Selection
   reuses the #159 set-aside machinery (SetDiceAside/DiceReturned), so the choice is
   persisted and broadcast to spectators; Keep commits the selected dice. *@
<div class="dice-tray @(GameState.IsMyTurn ? null : "dice-tray--readonly")">
  @foreach (var die in GameState.DiceInPlay)
  {
    var selected = die.IsSelected;
    <div class="dice-tray-die @(selected ? "selected" : null)"
         @key="die.Index"
         data-testid="tray-die"
         @onclick="() => ToggleAsync(die)">
      <Die DieValue="die.Value"
           Animate="die.IsAnimated"
           OnAnimated="ConsumeRollAnimationAsync"
           Selected="selected"
           Size="32">
      </Die>
    </div>
  }
</div>
