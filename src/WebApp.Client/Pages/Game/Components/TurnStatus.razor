@inherits BlazorState.BlazorStateComponent
@using WebApp.Client.Features

<MudText Typo="Typo.subtitle2" Class="mb-1">
  Playing as: <strong style="color: @GameState.PlayerColorFor(GameState.PlayerId.Value)">@GameState.PlayerName.Value</strong>
</MudText>
@{
  var waitingFor = GameState.Scoreboard
      .FirstOrDefault(p => p.PlayerId == GameState.CurrentPlayerId)?.Name
      ?? $"Player {GameState.CurrentPlayerId}";
}
@if (GameState.IsMyTurn)
{
  <MudAlert Severity="Severity.Success" Dense="true" data-testid="my-turn-indicator">
    It's your turn!
  </MudAlert>
}
else
{
  <MudAlert Severity="Severity.Info" Dense="true" data-testid="waiting-indicator">
    Waiting for <strong style="color: @GameState.ActivePlayerColor">@waitingFor</strong>…
  </MudAlert>
}

@code {
  private GameState GameState => GetState<GameState>();
}
