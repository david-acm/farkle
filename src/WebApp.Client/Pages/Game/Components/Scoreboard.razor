@using WebApp.Client.Features
@inherits BlazorState.BlazorStateComponent

@{
  var state   = GetState<GameState>();
  var leader  = state.Scoreboard.OrderByDescending(p => p.Score).FirstOrDefault();
}

<MudPaper data-testid="scoreboard" Class="scoreboard pa-2" Elevation="1">
  <MudText Typo="Typo.subtitle2" Class="mb-1">Scoreboard</MudText>
  @if (state.IsGameOver)
  {
    <MudPaper Class="pa-2 mb-2 text-center"
              Style="background: linear-gradient(135deg, #7A5C12 0%, #8B1A1A 100%);">
      <MudText Typo="Typo.subtitle1" Style="color: #F5F0E8;">🏆 @state.WinnerName wins!</MudText>
    </MudPaper>
  }
  <MudSimpleTable Dense="true" Hover="true" Class="scoreboard-table">
    <tbody>
      @foreach (var p in state.Scoreboard.OrderByDescending(p => p.Score))
      {
        var isLeader = leader is not null && p.PlayerId == leader.PlayerId && leader.Score > 0;
        <tr data-testid="@(isLeader ? "scoreboard-leader" : "scoreboard-row")">
          <td>
            <MudText Color="@(isLeader ? Color.Primary : Color.Default)" Typo="Typo.body2">
              @if (isLeader) { <strong>@p.Name</strong> } else { @p.Name }
            </MudText>
          </td>
          <td class="scoreboard-score">
            <MudText Color="@(isLeader ? Color.Primary : Color.Default)" Typo="Typo.body2">
              @if (isLeader) { <strong>@p.Score</strong> } else { @p.Score }
            </MudText>
          </td>
        </tr>
      }
    </tbody>
  </MudSimpleTable>
</MudPaper>

@code { }
