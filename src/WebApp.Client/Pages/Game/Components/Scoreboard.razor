@using WebApp.Client.Features
@inherits BlazorState.BlazorStateComponent

@{
  var state   = GetState<GameState>();
  var leader  = state.Scoreboard.OrderByDescending(p => p.Score).FirstOrDefault();
}

<MudCard data-testid="scoreboard" Class="mt-4">
  <MudCardHeader>
    <CardHeaderContent>
      <MudText Typo="Typo.h6">Scoreboard</MudText>
    </CardHeaderContent>
  </MudCardHeader>
  <MudCardContent>
    @if (state.IsGameOver)
    {
      <MudPaper Class="pa-4 mb-4 text-center"
                Style="background: linear-gradient(135deg, #D4AF37 0%, #8B1A1A 100%);">
        <MudText Typo="Typo.h5" Style="color: #F5F0E8;">🏆 @state.WinnerName wins!</MudText>
      </MudPaper>
    }
    <MudTable Items="@state.Scoreboard.OrderByDescending(p => p.Score)" Dense="true" Hover="true">
      <HeaderContent>
        <MudTh>Player</MudTh>
        <MudTh>Score</MudTh>
      </HeaderContent>
      <RowTemplate>
        @{
          var isLeader = leader is not null && context.PlayerId == leader.PlayerId && leader.Score > 0;
        }
        <MudTd data-testid="@(isLeader ? "scoreboard-leader" : "scoreboard-row")">
          @if (isLeader)
          {
            <MudText Color="Color.Primary"><strong>@context.Name</strong></MudText>
          }
          else
          {
            <MudText>@context.Name</MudText>
          }
        </MudTd>
        <MudTd>
          @if (isLeader)
          {
            <MudText Color="Color.Primary"><strong>@context.Score</strong></MudText>
          }
          else
          {
            <MudText>@context.Score</MudText>
          }
          <MudProgressLinear Value="@(Math.Min((double)context.Score / 10000 * 100, 100))"
                             Color="@(isLeader ? Color.Primary : Color.Default)"
                             Rounded="true" Size="Size.Small" Class="mt-1" />
        </MudTd>
      </RowTemplate>
    </MudTable>
  </MudCardContent>
</MudCard>

@code { }
