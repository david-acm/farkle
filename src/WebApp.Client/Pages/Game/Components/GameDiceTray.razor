@inherits WebApp.Client.Features.GameStateComponent
@using WebApp.Client.Features

@* Thin state-binding wrapper (#196): binds GameState to the presentational Blazor.Dice
   DiceTray and turns its callbacks into BlazorState actions. The reusable tray (layout,
   tap handling, selected visual) lives in Blazor.Dice; the game semantics stay here. *@
<DiceTray Dice="GameState.DiceInPlay"
          ReadOnly="!GameState.IsMyTurn"
          OnToggle="ToggleAsync"
          OnDieAnimated="ConsumeRollAnimationAsync">
</DiceTray>
