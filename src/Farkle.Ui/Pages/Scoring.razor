@page "/scoring"
@using Farkle.SharedKernel.Scoring
@using WebApp.Client.Pages.Game.Components

<PageTitle>Farkle scoring</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Scoring</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
  What each combination is worth. These scores are generated from the game's own scoring
  rules, so they always match what you'll actually be awarded.
</MudText>

<MudSimpleTable Hover="true" Dense="true" Class="scoring-table" data-testid="scoring-table" Style="max-width: 520px">
  <thead>
    <tr>
      <th>Example</th>
      <th>Combination</th>
      <th style="text-align:right">Score</th>
    </tr>
  </thead>
  <tbody>
    @foreach (var example in Examples)
    {
      var breakdown = ScoreCalculator.Evaluate(example);
      <tr data-testid="scoring-row">
        <td class="dice-example">@Glyphs(example)</td>
        <td>@breakdown.ToDisplayName()</td>
        <td style="text-align:right" data-testid="score-value">
          <MudText Color="Color.Primary" Typo="Typo.body2"><strong>@breakdown.Points</strong></MudText>
        </td>
      </tr>
    }
  </tbody>
</MudSimpleTable>

<MudText Typo="Typo.caption" Class="mt-3 d-block">
  Three of a kind scores its face value × 100 (three 1s are special at 1000). Keeping a second
  four-of-a-kind in the same turn doubles your running turn score.
</MudText>

@code {
  // Representative hands. The SCORES are computed by the shared ScoreCalculator below — never
  // hardcoded — so this page can't drift from the real rules (incl. future rule changes).
  private static readonly int[][] Examples =
  [
    [1],
    [5],
    [1, 1, 1],
    [2, 2, 2],
    [2, 2, 2, 2],
    [2, 2, 2, 2, 2],
    [1, 2, 3, 4, 5, 6],
    [2, 2, 4, 4, 6, 6],
    [2, 2, 2, 5, 5, 5],
    [2, 2, 2, 2, 2, 2],
  ];

  private static string Glyphs(int[] dice) =>
    string.Join(" ", dice.Select(d => DieValue.FromValue(d).Pip));
}
