@using GameState = Farkle.Ui.Features.GameState
@inherits BlazorState.BlazorStateComponent

<MudButton Class="mt-4"
           Color="Color.Primary"
           Disabled="@(IsDisabled || _loading)"
           FullWidth="true"
           OnClick="RollDiceAsync"
           StartIcon="@(_loading ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.PlayArrow)"
           Variant="Variant.Filled">
  Roll
</MudButton>

@code {
  [Parameter] public bool IsDisabled { get; set; }

  private bool _loading;

  private async Task RollDiceAsync(MouseEventArgs obj)
  {
    _loading = true;
    try { await Mediator.Send(new GameState.RollDice.Action()); }
    finally { _loading = false; }
  }
}
