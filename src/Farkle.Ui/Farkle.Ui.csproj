<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Overrides the net8.0 default in the root Directory.Build.props. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <!-- The game UI, shared by the Blazor WASM website (WebApp.Client hosts it) and the MAUI Hybrid
       app (HotDice.Shell) — the `maui-blazor-web` pattern, ADR 0008. Razor components, BlazorState
       actions/handlers, and the client services; no host, no WASM entry point, no MAUI. -->

  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" Version="5.0.0" />
    <PackageReference Include="Ardalis.Result" Version="10.1.0" />
    <PackageReference Include="Ardalis.SmartEnum" Version="8.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
    <!-- The WASM SDK supplied these transitively; the Razor SDK does not, so an RCL that logs and
         registers services has to ask for them. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.7" />
    <PackageReference Include="MudBlazor" Version="9.4.0" />
    <PackageReference Include="Blazor-State" Version="10.0.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Features\Actions\Components\ErrorModal.razor" />
  </ItemGroup>

  <!-- Dice UI primitives exposed app-wide as a global using, as before the move. The logging and
       DI usings were implicit under the WASM SDK; the Razor SDK does not add them, so they are
       declared here rather than sprinkling `using` lines through every moved file. -->
  <ItemGroup>
    <Using Include="Blazor.Dice" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blazor.Dice\Blazor.Dice.csproj" />
    <ProjectReference Include="..\Farkle.ApiClient\Farkle.ApiClient.csproj" />
    <ProjectReference Include="..\Farkle.Client\Farkle.Client.csproj" />
    <ProjectReference Include="..\Farkle.Shared\Farkle.Shared.csproj" />
  </ItemGroup>

</Project>
