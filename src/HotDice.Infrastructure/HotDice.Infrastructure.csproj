<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HotDice.Infrastructure</RootNamespace>
  </PropertyGroup>

  <!-- Infrastructure needs ASP.NET surface (DI/config/hosting, SignalR IHubContext, Identity,
       EF integration) but is not itself a web app, so reference the shared framework rather
       than using the Web SDK. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The event store is Marten (in the HotDice core, ADR 0004); this project owns only the
         Identity persistence, which is still Postgres via EF Core. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7" />
    <PackageReference Include="Serilog" Version="4.3.1" />

    <!-- Identity persistence (ASP.NET Identity + EF) and readiness health checks. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HotDice\HotDice.csproj" />
    <ProjectReference Include="..\HotDice.Shared\HotDice.Shared.csproj" />
  </ItemGroup>

</Project>
