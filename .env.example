# Local development secrets for docker-compose.
#
# Copy this file to `.env` (which is git-ignored) and adjust if needed:
#     cp .env.example .env
#
# These are throwaway LOCAL-DEVELOPMENT values for the docker-compose stack only.
# Never put production secrets here — production config is supplied via environment
# variables / a secret store (see issue #23, Azure Key Vault).
#
# Only credential VALUES live here; the connection strings are assembled from
# them in docker-compose.yml.

# Postgres (Identity) password.
POSTGRES_PASSWORD=farkle_dev_password

# EventStore credentials (the insecure-mode dev defaults).
ESDB_USER=admin
ESDB_PASSWORD=changeit

# Password for the dev HTTPS certificate mounted into the WebApp container.
KESTREL_CERT_PASSWORD=L0c4lS3cr3tP4ssw0rd
