@using Farkle.Spa.Features
@inject GameState GameState
@inherits BlazorState.BlazorStateComponent

<AppButton OnClick="StartGameAsync">
  Start game
</AppButton>

@code {
  private async Task StartGameAsync()
  {
    var gameId = GetState<GameState>().GameId;
    
    await Mediator.Send(new GameState.StartGame.Action(new(gameId)));
  }
}