@page "/"

<PageTitle>Play Farkle.Domain!</PageTitle>

<MudText Typo="Typo.h3">Be Welcome</MudText>
<GameTitle GameId="_gameId"></GameTitle>
<MudGrid Spacing="1">
  <MudItem xs="12" sm="6" md="4">
    <MudText Class="mt-6"
             Typo="Typo.h5">
      Roll the dice and don't Farkle!
    </MudText>
  </MudItem>
  <MudItem xs="12" sm="6" md="4">
    <TurnScore Value="_score"></TurnScore>
  </MudItem>
</MudGrid>


<MudGrid Spacing="1">
  <MudItem xs="12" sm="6" md="4">
    <StartGameButton
      OnGameStarted="GameStarted">
    </StartGameButton>
  </MudItem>
  <MudItem xs="12" sm="6" md="4">
    <KeepButton OnKeep="@DiceKeptAsync"></KeepButton>
  </MudItem>
  <MudItem xs="12" sm="6" md="4">
    <MudButton Class="mt-4"
               Color="Color.Primary"
               @onclick="RollAsync"
               StartIcon="@Icons.Material.Filled.PlayArrow"
               Variant="Variant.Filled">
      Roll
    </MudButton>
  </MudItem>
</MudGrid>

<MudPopover
  Open="@Error"
  AnchorOrigin="Origin.BottomCenter"
  TransformOrigin="Origin.TopCenter"
  Class="px-4 pt-4">
  <div class="d-flex flex-column">
    <MudText>@_errorMessage</MudText>
    <MudButton OnClick="@ToggleOpen" Class="ml-auto mr-n3 mb-1" Color="Color.Error">Close</MudButton>
  </div>
</MudPopover>

<DragabbleDice
  @bind-DiceInPlay="DiceInPlay">
</DragabbleDice>