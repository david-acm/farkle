@page "/"

<PageTitle>Play Farkle.Domain!</PageTitle>

<MudText Typo="Typo.h3">Be Welcome</MudText>
<GameTitle GameId="_gameId"></GameTitle>
<MudGrid Spacing="1">
  <MudItem sm="12">
    <MudText Class="mt-6"
             Typo="Typo.h5">
      Roll the dice and don't get Farkle.Domain!
    </MudText>
  </MudItem>
</MudGrid>
<MudPaper Class="pa-8">
  <MudCardActions>
    <TurnScore Value="_score"></TurnScore>
    <KeepButton OnKeep="@DiceKeptAsync"></KeepButton>
    <StartGameButton
      OnGameStarted="GameStarted">
    </StartGameButton>
    @* <MudTextField @bind-Value="DiceValues" *@
    @*               Immediate="true" *@
    @*               Label="Standard" *@
    @*               Variant="Variant.Text"> *@
    @* </MudTextField> *@
    <MudButton Class="mt-4"
               Color="Color.Primary"
               @onclick="RollAsync"
               StartIcon="@Icons.Material.Filled.PlayArrow"
               Variant="Variant.Filled">
      Roll
    </MudButton>
  </MudCardActions>
</MudPaper>

<MudPopover
  Open="@Error"
  AnchorOrigin="Origin.BottomCenter"
  TransformOrigin="Origin.TopCenter"
  Class="px-4 pt-4">
  <div class="d-flex flex-column">
    <MudText>@_errorMessage</MudText>
    <MudButton OnClick="@ToggleOpen" Class="ml-auto mr-n3 mb-1" Color="Color.Error">Close</MudButton>
  </div>
</MudPopover>

<DragabbleDice
  @bind-DiceInPlay="DiceInPlay">
</DragabbleDice>