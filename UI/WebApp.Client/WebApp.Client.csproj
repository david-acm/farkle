  <ItemGroup>
    <AdditionalFiles Include="Features\Actions\Components\ErrorModal.razor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Farkle.Contracts\Farkle.Contracts.csproj" />
