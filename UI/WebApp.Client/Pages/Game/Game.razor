@page "/games/{ParameterGameId:int}"
@inherits BlazorState.BlazorStateComponent
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Play Farkle!</PageTitle>

<MudText Typo="Typo.h3">Welcome!</MudText>
<GameTitle></GameTitle>
<MudGrid Spacing="1">
  <MudItem xs="12" sm="6" md="4">
    <MudText Class="mt-6"
             Typo="Typo.h5">
      Roll the dice and don't Farkle!
    </MudText>
  </MudItem>
  <MudItem xs="12" sm="6" md="4">
    <TurnScore></TurnScore>
  </MudItem>
</MudGrid>


<MudGrid Spacing="1" Class="mt-8">
  <MudItem xs="12" sm="6" md="4">
    <StartGameButton />
  </MudItem>
  <MudItem xs="12" sm="6" md="4">
    <KeepButton />
  </MudItem>
  <MudItem xs="12" sm="6" md="4">
    <RollDiceButton />
  </MudItem>
</MudGrid>


<MudContainer Class="mt-8">
  <DragabbleDice>
  </DragabbleDice>
  
</MudContainer>