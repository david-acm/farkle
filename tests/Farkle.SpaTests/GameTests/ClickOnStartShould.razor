<h3>ClickOnStartShould</h3>
@using AutoFixture.Xunit2
@using BlazorState
@using Moq
@using MudBlazor.Services
@using WebApp.Client.Pages.Game
@using WebApp.Client.Services
@inherits TestContext

@code {
  private readonly IGameService _gameService;
  
  // TODO: Refactor common inicialization logic
  public ClickOnStartShould()
  {
    _gameService = Mock.Of<IGameService>();
    Services.AddScoped<IGameService>(_ => _gameService);
    Services.AddScoped<IRotationCalculator>(_ => Mock.Of<IRotationCalculator>());
    Services.AddMudServices();
    
    Services.AddBlazorState(o => o.Assemblies = [typeof(Program).Assembly]);
  }
  
  [Theory]
  [AutoData]
  public void UpdateGameId(int gameId)
  {
    // Given
    JSInterop.Mode = JSRuntimeMode.Loose;
    Mock.Get(_gameService)
      .Setup(gs => gs.StartGameAsync(It.IsAny<int>()))
      .ReturnsAsync(gameId);
    var cut = Render(@<Game ParameterGameId="gameId"/>);
    var button = cut.FindComponent<StartGameButton>()
      .Find("button");
    
    // When
    // button.Click();
    
    // Then
    Mock.Get(_gameService).Verify(s => s.StartGameAsync(It.IsAny<int>()), Times.Once);
    cut.FindComponent<GameTitle>().Instance.GameId.Should().Be(gameId);
  }
}