@using WebApp.Client.Services
@using WebApp.Client.Pages.Game.Components
@inherits BunitContext

@code {

  [Fact]
  public void ShouldAnimate()
  {
    // Arrange
    var context = new BunitContext();
    context.Services.AddScoped<IRotationCalculator, RotationCalculator>();
    var cut = context.Render(@<Die DieValue="DieValue.Four"></Die>);
    var die = cut.Find(".die-container");

    // Act
    die.PointerEnter();

    // Assert
    cut.WaitForAssertion(() =>
      cut.Find("style").InnerHtml.Should().Contain(@"scale3d(1.4, 1.4, 1.4);"));
  }

  [Fact]
  public void ShouldReturnToInitialSize()
  {
    // Arrange
    var context = new BunitContext();
    context.Services.AddScoped<IRotationCalculator, RotationCalculator>();
    var cut = context.Render(@<Die DieValue="DieValue.Four"></Die>);
    var die = cut.Find(".die-container");

    // Act
    die.PointerEnter();
    die.PointerLeave(new PointerEventArgs());

    // Assert
    cut.WaitForAssertion(() =>
      cut.Find("style").InnerHtml.Should().Contain(@"scale3d(1, 1, 1);"));
  }

}
