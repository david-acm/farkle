@inherits GameBunitContext
@using BlazorState
@using Moq
@using WebApp.Client.Features
@using WebApp.Client.Pages.Game
@using WebApp.Client.Pages.Game.Components

@code {
  // B1 — Game renders Join form before joining, swaps to gameplay UI after.

  [Fact]
  public void RenderJoinForm_BeforeJoining()
  {
    var cut = Render(@<Game></Game>);

    cut.Markup.Should().Contain("Enter your name to join");
    cut.FindAll("button").Should().NotContain(b => b.TextContent.Contains("Roll"),
      "Roll appears only after Join");
  }

  [Fact]
  public void RenderGameplayUi_AfterJoining()
  {
    var cut = Render(@<Game></Game>);
    JoinGame(cut, "Alice", assignedPlayerId: 1);

    cut.Markup.Should().NotContain("Enter your name to join");
    cut.FindComponents<RollDiceButton>().Should().ContainSingle();
    cut.FindComponents<KeepButton>().Should().ContainSingle();
    cut.FindComponents<PassTurnButton>().Should().ContainSingle();
  }
}
