<h3>ClickOnStartShould</h3>
@using AutoFixture.Xunit2
@using BlazorState
@using Moq
@using MudBlazor.Services
@using WebApp.Client.Pages.Game
@using WebApp.Client.Services
@inherits GameBunitContext

@code {
  [Theory]
  [AutoData]
  public void UpdateGameId(int gameId)
  {
    // Given
    Mock.Get(GameService)
      .Setup(gs => gs.StartGameAsync(It.IsAny<int>()))
      .ReturnsAsync(gameId);
    var cut = Render(@<Game ParameterGameId="gameId"/>);
    JoinGame(cut);

    // When
    // StartGame is dispatched automatically in OnParametersSetAsync

    // Then
    Mock.Get(GameService).Verify(s => s.StartGameAsync(It.IsAny<int>()), Times.Once);
    cut.FindComponent<GameTitle>().Instance.GameId.Should().Be(gameId);
  }
}
