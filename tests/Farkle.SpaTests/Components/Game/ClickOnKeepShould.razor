<h3>ClickOnKeepShould</h3>
@using Ardalis.Result
@using BlazorState
@using Farkle.Contracts
@using MediatR
@using Moq
@using MudBlazor.Services
@using WebApp.Client.Features
@using WebApp.Client.Pages.Game
@using WebApp.Client.Pages.Game.Components
@using WebApp.Client.Services
@using TurnScore = WebApp.Client.Pages.Game.Components.TurnScore
@inherits GameBunitContext

@code {
  [Fact]
  public async Task CallUpdateScore()
  {
    // Given
    const int playerId = 1;
    var gameId         = new GameId(10);
    var expectedScore  = 200;
    // #286 — Keep is only enabled once a scoring selection is staged, so roll a Five and set
    // it aside before clicking Keep.
    Mock.Get(GameService)
      .Setup(s => s.RollDiceAsync(It.IsAny<int>(), It.IsAny<int>()))
      .ReturnsAsync(Result<IList<DieValue>>.Success(new List<DieValue> { DieValue.Five }));
    Mock.Get(GameService)
      .Setup(s => s.KeepDiceAsync(It.IsAny<int>(), It.IsAny<int>(), It.IsAny<IEnumerable<int>>()))
      .ReturnsAsync(new HttpResponses.KeepDiceResponse(gameId, expectedScore));

    var game = Render<Game>(@<Game ParameterGameId="gameId"/>);
    JoinGame(game);
    await game.FindComponent<RollDiceButton>().Find("button").ClickAsync(new MouseEventArgs());
    var sender = Services.GetRequiredService<ISender>();
    await sender.Send(new GameState.SetDiceAside.Action(DiceInfo.Selected(0, DieValue.Five)));

    var score  = game.FindComponent<TurnScore>();
    var button = game.FindComponent<KeepButton>().Find("button");

    // When
    await button.ClickAsync(new MouseEventArgs());

    // Then
    Mock.Get(GameService).Verify(s => s.KeepDiceAsync(gameId, playerId, It.IsAny<IEnumerable<int>>()));
    score.Instance.Value.Should().Be(expectedScore);
  }
}
