@inherits BunitContext
@using MudBlazor.Services
@using WebApp.Client.Pages

@code {
  private void SetUp()
  {
    JSInterop.Mode = JSRuntimeMode.Loose;
    Services.AddMudServices();
  }

  [Fact]
  public void ShowDescriptionRepoLinkAndVersion()
  {
    SetUp();

    var cut = Render(@<About></About>);

    cut.Markup.Should().Contain("event sourcing");
    // The repo link points at the real repository (the old stub linked a non-existent one).
    cut.Find("a[href='https://github.com/david-acm/farkle']").Should().NotBeNull();
    // The version is surfaced (whatever AppVersion resolves to — never empty).
    cut.Find("[data-testid='app-version']").TextContent.Should().MatchRegex(@"Version\s+\S+");
  }
}
