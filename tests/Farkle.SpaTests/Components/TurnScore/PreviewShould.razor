@inherits BunitContext
@using BlazorState
@using MudBlazor.Services
@using WebApp.Client.Features
@using WebApp.Client.Pages.Game.Components

@code {
  // #182 — TurnScore shows a live preview of the current selection's value (trick + points)
  // via the shared ScoreCalculator, before the player commits with Keep.

  private IStore SetUp()
  {
    JSInterop.Mode = JSRuntimeMode.Loose;
    Services.AddMudServices();
    Services.AddBlazorState(o => o.Assemblies = [typeof(GameState).Assembly]);
    return Services.GetRequiredService<IStore>();
  }

  [Fact]
  public void ShowTheTrickAndPoints_ForAScoringSelection()
  {
    var store = SetUp();
    var state = store.GetState<GameState>();
    state.DiceInPlay.Clear();
    state.DiceInPlay.Add(DiceInfo.Selected(0, DieValue.Four));
    state.DiceInPlay.Add(DiceInfo.Selected(1, DieValue.Four));
    state.DiceInPlay.Add(DiceInfo.Selected(2, DieValue.Four));

    var cut = Render(@<TurnScore></TurnScore>);

    cut.Find("[data-testid='selection-preview']").TextContent
      .Should().Contain("Three of a kind").And.Contain("+400"); // three 4s = 4×100
  }

  [Fact]
  public void ListEveryTrickAndTheSummedPoints_ForAMultiTrickSelection()
  {
    // #270 — selecting a three-of-a-kind plus a pair of 5s lists both tricks and the sum.
    var store = SetUp();
    var state = store.GetState<GameState>();
    state.DiceInPlay.Clear();
    state.DiceInPlay.Add(DiceInfo.Selected(0, DieValue.Two));
    state.DiceInPlay.Add(DiceInfo.Selected(1, DieValue.Two));
    state.DiceInPlay.Add(DiceInfo.Selected(2, DieValue.Two));
    state.DiceInPlay.Add(DiceInfo.Selected(3, DieValue.Five));
    state.DiceInPlay.Add(DiceInfo.Selected(4, DieValue.Five));

    var cut = Render(@<TurnScore></TurnScore>);

    cut.Find("[data-testid='selection-preview']").TextContent
      .Should().Contain("Three of a kind").And.Contain("Ones & fives").And.Contain("+400");
  }

  [Fact]
  public void ShowNoScore_ForANonScoringSelection()
  {
    var store = SetUp();
    var state = store.GetState<GameState>();
    state.DiceInPlay.Clear();
    state.DiceInPlay.Add(DiceInfo.Selected(0, DieValue.Two)); // a lone 2 isn't keepable

    var cut = Render(@<TurnScore></TurnScore>);

    cut.Find("[data-testid='selection-preview']").TextContent.Should().Contain("No score");
  }

  [Fact]
  public void HideThePreview_WhenNothingIsSelected()
  {
    var store = SetUp();
    var state = store.GetState<GameState>();
    state.DiceInPlay.Clear();
    state.DiceInPlay.Add(DiceInfo.Unselected(0, DieValue.Four));

    var cut = Render(@<TurnScore></TurnScore>);

    cut.FindAll("[data-testid='selection-preview']").Should().BeEmpty();
  }
}
