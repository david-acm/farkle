@inherits BunitContext
@using BlazorState
@using MediatR
@using Moq
@using Farkle.Contracts
@using Farkle.Ui.Services
@* Do not @using Farkle.Ui.Features here — its TurnScore record collides
   with the TurnScore component in Pages.Game.Components (already imported
   globally via _Imports.razor). Reference GameState by full name below. *@

@code {
  // B6 — TurnScore component reads from GameState.TurnScore and re-renders
  // when state changes. It renders the bare numeric value with MudBlazor
  // typography (no raw record / curly braces), surfaced via data-testid.

  [Fact]
  public void RenderInitialZeroScore()
  {
    JSInterop.Mode = JSRuntimeMode.Loose;
    Services.AddBlazorState(o => o.Assemblies = [typeof(Farkle.Ui.Features.GameState).Assembly]);

    var cut = Render(@<TurnScore></TurnScore>);

    var score = cut.Find("[data-testid='turn-score']");
    score.TextContent.Trim().Should().Be("0");
    // The old bug rendered the record itself (e.g. "TurnScore { Value = 0 }").
    cut.Markup.Should().NotContain("TurnScore {");
  }

  [Fact]
  public async Task UpdateRenderedScore_WhenKeepDiceResponseSetsIt()
  {
    JSInterop.Mode = JSRuntimeMode.Loose;
    var gameService = Mock.Of<IGameService>();
    Services.AddScoped<IGameService>(_ => gameService);
    Services.AddBlazorState(o => o.Assemblies = [typeof(Farkle.Ui.Features.GameState).Assembly]);

    var cut = Render(@<TurnScore></TurnScore>);
    cut.Find("[data-testid='turn-score']").TextContent.Trim().Should().Be("0");

    // Trigger the only legitimate state path that mutates TurnScore on the
    // client: a successful KeepDice with the score the server returned.
    Mock.Get(gameService)
      .Setup(s => s.KeepDiceAsync(It.IsAny<int>(), It.IsAny<int>(), It.IsAny<IEnumerable<int>>()))
      .ReturnsAsync(new HttpResponses.KeepDiceResponse(0, 200));
    var sender = Services.GetRequiredService<ISender>();
    await sender.Send(new Farkle.Ui.Features.GameState.KeepDice.Action());

    cut.WaitForAssertion(() =>
      cut.Find("[data-testid='turn-score']").TextContent.Trim().Should().Be("200"));
  }
}
