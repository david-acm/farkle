@inherits BunitContext
@using BlazorState
@using Moq
@using WebApp.Client.Features
@using WebApp.Client.Pages.Game.Components
@using WebApp.Client.Services

@code {
  // B4 + B5 — DragabbleDice should render one Die per item in DiceInPlay,
  // with the right DieValue, routed into the zone whose Identifier matches.

  private IStore SetUp()
  {
    JSInterop.Mode = JSRuntimeMode.Loose;
    Services.AddScoped<IRotationCalculator>(_ => Mock.Of<IRotationCalculator>());
    Services.AddBlazorState(o => o.Assemblies = [typeof(GameState).Assembly]);
    return Services.GetRequiredService<IStore>();
  }

  [Fact]
  public void RenderOneDiePerInPlayItem_WithCorrectValue()
  {
    var store = SetUp();
    var state = store.GetState<GameState>();
    state.DiceInPlay.Add(new DraggableDie(0, DieValue.Two,   "Rolled"));
    state.DiceInPlay.Add(new DraggableDie(1, DieValue.Three, "Rolled"));
    state.DiceInPlay.Add(new DraggableDie(2, DieValue.Five,  "Rolled"));

    var cut = Render(@<DragabbleDice></DragabbleDice>);

    var dice = cut.FindComponents<Die>();
    dice.Should().HaveCount(3);
    dice.Select(d => d.Instance.DieValue)
        .Should().Equal(DieValue.Two, DieValue.Three, DieValue.Five);
  }

  [Fact]
  public void RouteDiceToZoneByIdentifier()
  {
    var store = SetUp();
    var state = store.GetState<GameState>();
    state.DiceInPlay.Add(new DraggableDie(0, DieValue.Five, "SetAside"));
    state.DiceInPlay.Add(new DraggableDie(1, DieValue.Two,  "Rolled"));

    var cut = Render(@<DragabbleDice></DragabbleDice>);

    var container = cut.Find(".mud-drop-container");
    var rolledZone   = container.Children[0];
    var setAsideZone = container.Children[1];

    rolledZone.OuterHtml.Should().Contain("Rolled");
    setAsideZone.OuterHtml.Should().Contain("SetAside");

    // Zone children = label + N dice. Two dice total → one per zone.
    rolledZone.Children.Should().HaveCount(2,   "Rolled zone holds label + the one 'Rolled' die");
    setAsideZone.Children.Should().HaveCount(2, "SetAside zone holds label + the one 'SetAside' die");
  }
}
