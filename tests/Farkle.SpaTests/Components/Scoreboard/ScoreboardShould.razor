@using BlazorState
@using Moq
@using MudBlazor.Services
@using WebApp.Client.Pages.Game
@using WebApp.Client.Pages.Game.Components
@using WebApp.Client.Services
@using static Farkle.Contracts.HttpResponses
@inherits GameBunitContext

@code {

  [Fact]
  public async Task ShowsAllPlayersAndHighlightsLeaderAfterPassTurn()
  {
    // Given — PassTurn returns a 2-player scoreboard; player 1 has scored, player 2 has not.
    Mock.Get(GameService)
      .Setup(g => g.PassTurnAsync(It.IsAny<int>(), It.IsAny<int>()))
      .ReturnsAsync(new PassTurnResponse(
        GameId:          1,
        PlayerId:        1,
        NewScore:        200,
        Winner:          null,
        CurrentPlayerId: 2,
        Scoreboard: [
          new PlayerScore(1, "David",   200),
          new PlayerScore(2, "Allison", 0),
        ]));

    var cut = Render(@<Game></Game>);
    JoinGame(cut);

    var passButton = cut.FindComponent<PassTurnButton>().Find("button");

    // When
    await cut.InvokeAsync(() => passButton.Click());

    // Then — scoreboard element is present
    var scoreboard = cut.Find("[data-testid='scoreboard']");
    scoreboard.Should().NotBeNull();

    var scoreboardText = scoreboard.InnerHtml;
    scoreboardText.Should().Contain("David",   "David should appear on the scoreboard");
    scoreboardText.Should().Contain("Allison", "Allison should appear on the scoreboard");

    // Leader row is marked
    var leader = cut.Find("[data-testid='scoreboard-leader']");
    leader.Should().NotBeNull("the leading player should have a special testid");
    leader.InnerHtml.Should().Contain("David", "David has the highest score so is the leader");
  }

}
