@using System.Text.RegularExpressions
@using AutoFixture.Xunit2
@using Moq
@using WebApp.Client.Pages.Game.Components
@using WebApp.Client.Services
@inherits BunitContext

These tests are written entirely in razor and C# syntax.

Learn more at https://bunit.dev/docs/getting-started/writing-tests.html#creating-basic-tests-in-razor-files

@code {

  [Theory]
  [AutoData]
  public void SpinToFaceWhenRolled(int xExpected, int yExpected, int zExpected)
  {
    // A rolled die animates: it asks the calculator for a *spun* rotation
    // (randomSpin: true) and rotates to it after the first render.
    var mock = Mock.Of<IRotationCalculator>();
    Mock.Get(mock)
      .Setup(c => c.CalculateFor(It.IsAny<DieValue>(), true))
      .Returns((xExpected, yExpected, zExpected));
    Services.AddScoped<IRotationCalculator>(_ => mock);

    var cut = Render<Die>(c => c
      .Add(d => d.DieValue, DieValue.None)
      .Add(d => d.Animate,  true));

    cut.WaitForAssertion(RotationShouldMatch(xExpected, yExpected, zExpected, cut),
      TimeSpan.FromMilliseconds(400));
  }

  [Theory]
  [AutoData]
  public void RenderFaceWithoutSpinWhenNotRolled(
    int xExpected, int yExpected, int zExpected)
  {
    // A settled / moved die (Animate=false) must NOT spin: it asks the calculator
    // for the plain face rotation (randomSpin: false) and never the spun variant,
    // so dragging a die between zones never looks like a re-roll.
    var mock = Mock.Of<IRotationCalculator>();
    Mock.Get(mock)
      .Setup(c => c.CalculateFor(It.IsAny<DieValue>(), false))
      .Returns((xExpected, yExpected, zExpected));
    Services.AddScoped<IRotationCalculator>(_ => mock);

    var cut = Render<Die>(c => c
      .Add(d => d.DieValue, DieValue.None)
      .Add(d => d.Animate,  false));

    cut.WaitForAssertion(RotationShouldMatch(xExpected, yExpected, zExpected, cut),
      TimeSpan.FromMilliseconds(400));
    Mock.Get(mock).Verify(c => c.CalculateFor(It.IsAny<DieValue>(), true), Times.Never,
      "a non-rolled die must never request a spinning rotation");
  }

  private Action RotationShouldMatch(int xExpected, int yExpected, int zExpected, IRenderedComponent<Die> cut) => () =>
  {
    var innerHtml = cut.Find("style").InnerHtml;
    RotationShouldBe(xExpected, innerHtml, @"rotateX\((-?\d+)deg\)");
    RotationShouldBe(yExpected, innerHtml, @"rotateY\((-?\d+)deg\)");
    RotationShouldBe(zExpected, innerHtml, @"rotateZ\((-?\d+)deg\)");
  };

  private void RotationShouldBe(int xExpected, string innerHtml, string axis)
  {
    TryGetNumberFrom(axis, innerHtml, out var xRotation);
    (xRotation % 360).Should().Be(xExpected);
  }

  private bool TryGetNumberFrom(string pattern, string text, out int result)
  {
    // var pattern = @"rotate\((\d+)deg\)";
    result = 0;

    var match = Regex.Match(text, pattern);

    if (!match.Success) return false;
    var number = match.Groups[1].Value;

    return int.TryParse(number, out result);
  }

}