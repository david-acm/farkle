<h3>ReturnDieToRolledShould</h3>
@using Ardalis.Result
@using BlazorState
@using Farkle.Contracts
@using MediatR
@using Moq
@using MudBlazor.Services
@using WebApp.Client.Features
@using WebApp.Client.Pages.Game
@using WebApp.Client.Pages.Game.Components
@using WebApp.Client.Services
@inherits GameBunitContext

@code {
  [Fact]
  public async Task NotSendDieToServer_WhenReturnedToRolled()
  {
    // Given — roll returns two Fives (so a scoring selection can survive returning one; #286
    // gates Keep behind a selection that scores, so we can no longer keep an empty selection).
    var gameId = new GameId(10);
    Mock.Get(GameService)
      .Setup(s => s.RollDiceAsync(It.IsAny<int>(), It.IsAny<int>()))
      .ReturnsAsync(Result<IList<DieValue>>.Success(new List<DieValue> { DieValue.Five, DieValue.Five }));

    // Capture dice argument as a snapshot before the handler clears DiceSetAside.
    // Moq captures the list reference; without ToList() the assertion would see the
    // already-cleared list and pass even when the bug is present.
    List<int>? capturedDice = null;
    Mock.Get(GameService)
      .Setup(s => s.KeepDiceAsync(It.IsAny<int>(), It.IsAny<int>(), It.IsAny<IEnumerable<int>>()))
      .Callback<int, int, IEnumerable<int>>((_, _, d) => capturedDice = d.ToList())
      .ReturnsAsync(new HttpResponses.KeepDiceResponse(gameId, 0));

    var game = Render<Game>(@<Game ParameterGameId="gameId"/>);
    JoinGame(game);

    // Roll to populate DiceInPlay with [Five, Five]
    await game.FindComponent<RollDiceButton>().Find("button").ClickAsync(new MouseEventArgs());

    // Set both Fives aside, then return the second one (→ Rolled). The first Five keeps the
    // selection scoring so Keep stays enabled.
    var sender = Services.GetRequiredService<ISender>();
    await sender.Send(new GameState.SetDiceAside.Action(DiceInfo.Selected(0, DieValue.Five)));
    await sender.Send(new GameState.SetDiceAside.Action(DiceInfo.Selected(1, DieValue.Five)));
    await sender.Send(new GameState.SetDiceAside.Action(DiceInfo.Unselected(1, DieValue.Five)));

    // When — player clicks "Set Dice Aside"
    await game.FindComponent<KeepButton>().Find("button").ClickAsync(new MouseEventArgs());

    // Then — the die returned to Rolled must NOT appear in the server call (only one Five sent)
    capturedDice.Should().NotBeNull("KeepDiceAsync should have been called");
    capturedDice!.Should().ContainSingle("a die returned to Rolled must not be sent to the server")
      .Which.Should().Be(5);
  }
}
