@inherits GameBunitContext
@using HotDice.Ui.Features
@using HotDice.Ui.Pages.Game
@using HotDice.Ui.Pages.Game.Components
@using static HotDice.Contracts.HttpResponses

@code {
  // Covers the lobby waiting-room view rendered by Game while WaitingForPlayers.

  [Fact]
  public void ShowLobby_AfterJoining_WhileWaitingForPlayers()
  {
    var cut = Render(@<Game></Game>);
    JoinLobby(cut, "Alice", assignedPlayerId: 1, hostPlayerId: 1);

    cut.FindComponents<Lobby>().Should().ContainSingle();
    cut.FindAll("[data-testid='roster-player']").Should().ContainSingle();
    cut.FindComponents<RollDiceButton>().Should().BeEmpty("play has not begun yet");
  }

  [Fact]
  public void EnableStart_ForHost_WithASinglePlayer()
  {
    var cut = Render(@<Game></Game>);
    JoinLobby(cut, "Alice", assignedPlayerId: 1, hostPlayerId: 1);

    var start = cut.Find("[data-testid='start-game-button']");
    start.HasAttribute("disabled").Should().BeFalse();
  }

  [Fact]
  public void EnableStart_ForHost_WhenTwoOrMorePlayersJoined()
  {
    var cut = Render(@<Game></Game>);
    JoinLobby(cut, "Alice", assignedPlayerId: 1, hostPlayerId: 1,
      roster: [new LobbyPlayer(1, "Alice"), new LobbyPlayer(2, "Bob")]);

    var start = cut.Find("[data-testid='start-game-button']");
    start.HasAttribute("disabled").Should().BeFalse();
  }

  [Fact]
  public void HideStart_AndShowWaiting_ForNonHostPlayers()
  {
    var cut = Render(@<Game></Game>);
    JoinLobby(cut, "Bob", assignedPlayerId: 2, hostPlayerId: 1,
      roster: [new LobbyPlayer(1, "Alice"), new LobbyPlayer(2, "Bob")]);

    cut.FindAll("[data-testid='start-game-button']").Should().BeEmpty();
    cut.FindAll("[data-testid='waiting-for-host']").Should().ContainSingle();
  }
}
