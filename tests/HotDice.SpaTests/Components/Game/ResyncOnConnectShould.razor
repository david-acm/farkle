@inherits GameBunitContext
@using Moq
@using HotDice.Ui.Features
@using HotDice.Ui.Pages.Game
@using HotDice.Ui.Services

@code {
  // #236 — after the SignalR connection is established, the client reconciles against the server
  // snapshot (GET /api/games/{id}) so a broadcast missed during the connect window (e.g. GameBegan
  // sent between the HTTP join and the group-join) self-heals instead of leaving the player stuck.

  [Fact]
  public void ReconcileGameState_AfterConnecting()
  {
    var cut = Render(@<Game></Game>);
    JoinLobby(cut, "Bob", assignedPlayerId: 2, hostPlayerId: 1);

    // Joining wires the hub then reconciles — GetGameStateAsync is the snapshot fetch.
    cut.WaitForAssertion(() =>
      Mock.Get(GameService).Verify(s => s.GetGameStateAsync(It.IsAny<int>()), Times.AtLeastOnce()));
  }
}
