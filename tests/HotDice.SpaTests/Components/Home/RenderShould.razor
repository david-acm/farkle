@inherits GameBunitContext
@using HotDice.Ui.Pages

@code {
  // The landing page must render both name inputs and both action buttons.
  [Fact]
  public void RenderStartAndJoinCards()
  {
    var cut = Render(@<Home/>);

    // Inputs are selected by placeholder text (same convention as the join form).
    cut.FindAll("[placeholder='Your name']").Should().NotBeEmpty("both cards prompt for a name");
    cut.FindAll("[placeholder='Game code']").Should().ContainSingle("the join card needs a code field");

    // Buttons are selected by their data-testid.
    cut.Find("[data-testid='start-new-game']").Should().NotBeNull();
    cut.Find("[data-testid='join-existing-game']").Should().NotBeNull();
  }
}
