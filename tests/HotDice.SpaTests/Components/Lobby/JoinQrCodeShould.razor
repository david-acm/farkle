@inherits BunitContext
@using HotDice.Ui.Pages.Game.Components

@code {
  // Issue #163 — the lobby shows a scannable QR image encoding the join URL.
  // We don't decode the QR here (that's an E2E/manual concern); we assert the
  // component emits a real PNG image, with the join URL recorded for the share
  // flow and meaningful alt text for accessibility.

  [Fact]
  public void RenderAPngQrImage_ForTheJoinUrl()
  {
    JSInterop.Mode = JSRuntimeMode.Loose;
    const string url = "http://localhost/games/7";

    var cut = Render<JoinQrCode>(p => p.Add(c => c.JoinUrl, url));

    var img = cut.Find("img[data-testid='join-qr']");
    img.GetAttribute("src").Should().StartWith("data:image/png;base64,");
    img.GetAttribute("src")!.Length.Should().BeGreaterThan("data:image/png;base64,".Length,
      "the QR image must actually contain encoded data");
    img.GetAttribute("alt").Should().NotBeNullOrWhiteSpace("the QR image needs alt text");
    img.GetAttribute("data-join-url").Should().Be(url);
  }

  [Fact]
  public void ProduceDifferentImages_ForDifferentGames()
  {
    JSInterop.Mode = JSRuntimeMode.Loose;

    var one = Render<JoinQrCode>(p => p.Add(c => c.JoinUrl, "http://localhost/games/1"))
      .Find("img[data-testid='join-qr']").GetAttribute("src");
    var two = Render<JoinQrCode>(p => p.Add(c => c.JoinUrl, "http://localhost/games/2"))
      .Find("img[data-testid='join-qr']").GetAttribute("src");

    two.Should().NotBe(one, "a different game must yield a different QR code");
  }
}
