<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>HotDice.ArchitectureTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnit" Version="0.13.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- References every production project so the architecture model can load all assemblies
       (via Mono.Cecil) and assert cross-project dependency rules. WebApp transitively brings
       HotDice, WebApp.Client, HotDice.Shared; reference them explicitly
       too so their DLLs are guaranteed in the test output for the directory-based loader. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\HotDice\HotDice.csproj" />
    <ProjectReference Include="..\..\src\HotDice.Shared\HotDice.Shared.csproj" />
    <ProjectReference Include="..\..\src\HotDice.ApiClient\HotDice.ApiClient.csproj" />
    <ProjectReference Include="..\..\src\WebApp\WebApp.csproj" />
    <ProjectReference Include="..\..\src\WebApp.Client\WebApp.Client.csproj" />
    <ProjectReference Include="..\..\src\HotDice.Infrastructure\HotDice.Infrastructure.csproj" />
  </ItemGroup>

</Project>
